					},
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"if (pm.response.code === 201) { pm.globals.set('targetCustomerId', pm.response.json().id); }",
						"pm.test('201 created (400 = already registered, fine on re-runs)', () => pm.expect([201, 400]).to.include(pm.response.code));"
